# ─── Clerk (auth) ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Supabase (source of truth; see AGENTS.md §7) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Scraping ─────────────────────────────────────────────────────────────────
# Scraper HTML source: "direct" (free plain fetch — branch default) or "oxylabs" (paid Web Scraper API)
SCRAPER_PROVIDER=direct
OXY_WSA_USERNAME=
OXY_WSA_PASSWORD=

# ─── AI analysis + embeddings (AGENTS.md §19/§20) ─────────────────────────────
# Analysis: google/gemini-2.5-flash · Embeddings: text-embedding-3-small (1536 dims)
OPENROUTER_API_KEY=
# Optional; articles analyzed per batch (default 5)
ANALYSIS_BATCH_SIZE=

# ─── Admin + cron ─────────────────────────────────────────────────────────────
# Shared secret for the x-skeem-admin-secret header on action routes (AGENTS.md §15)
SKEEM_ADMIN_SECRET=
# NOTE: CRON_SECRET is injected by Vercel on cron requests — do NOT add it here (AGENTS.md §18)
